{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && npm run build",
    "outputDir": "dist"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "environments": {
    "production": {
      "variables": {
        "VITE_MTOS_API_BASE": "https://mtos-api.onrender.com"
      }
    },
    "development": {
      "variables": {
        "VITE_MTOS_API_BASE": "http://localhost:3000"
      }
    }
  }
}
